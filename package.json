{
  "name": "skapeio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:ai-studio": "DISABLE_HMR=true next dev --webpack",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint . && npm run lint:css",
    "lint:fix": "eslint . --fix && npm run lint:css:fix",
    "lint:css": "stylelint \"{app,components}/**/*.css\"",
    "lint:css:fix": "stylelint \"{app,components}/**/*.css\" --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:production": "PLAYWRIGHT_USE_PRODUCTION=true playwright test",
    "analyze": "next experimental-analyze --output",
    "check:budget": "node scripts/check-build-budgets.mjs",
    "audit:prod": "npm audit --omit=dev",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run check:budget && npm run test:e2e:production && npm run audit:prod"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.5.4",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "postcss": "^8.5.26",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-order": "^8.1.1",
    "typescript": "5.9.3"
  }
}
